{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "title": "Stored branching path and choices, private scenario_progress store",
  "required": [
    "scenario_contract_version",
    "scenario_id",
    "scenario_state",
    "status"
  ],
  "properties": {
    "scenario_contract_version": {
      "const": "1.0.0"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^PCI-SC-CH[0-9]{2}-[0-9]{3}$"
    },
    "scenario_version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "in_progress",
        "outcome",
        "completed",
        "exited"
      ]
    },
    "scenario_state": {
      "type": "object",
      "required": [
        "scenario_id",
        "node_id",
        "history",
        "status",
        "reflection",
        "started_at"
      ],
      "properties": {
        "node_id": {
          "type": "string"
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "node_id",
              "choice_index",
              "target",
              "text",
              "rationale"
            ]
          }
        },
        "reflection": {
          "type": "string",
          "maxLength": 5000
        }
      }
    }
  }
}
