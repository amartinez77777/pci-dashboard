{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "title": "Prediction private record stored BEFORE observed outcome",
  "required": [
    "feedback_contract_version",
    "experiment_id",
    "goal_id",
    "prediction",
    "predicted_at"
  ],
  "properties": {
    "experiment_id": {
      "type": "string",
      "maxLength": 3000
    },
    "goal_id": {
      "type": "string",
      "maxLength": 3000
    },
    "prediction": {
      "type": "string",
      "maxLength": 3000
    },
    "predicted_at": {
      "type": "string",
      "maxLength": 3000
    },
    "feedback_contract_version": {
      "const": "1.0.0"
    }
  }
}
