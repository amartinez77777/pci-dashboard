    "goal_metrics",
    "quiz_attempts"
  ],
  "migration": {
    "from": 1,
    "to": 2,
    "strategy": "additive create-new-stores; leave six legacy stores in place; import v1 envelopes by wrapping preserving original id as legacy_id and synthesizing deterministic namespaced UUID",
    "transaction": "all record writes and metadata commit in same IndexedDB versionchange/import transaction",
    "unknown_future_version": "reject_without_modification"
  },
  "personal_data_no_public_assets": true,
  "optional_sensitive_consent": "sensitive records require consent_id referencing local granted consent; revoke stops new capture; deletion user controlled",
  "export": "explicit selection and warning; never transmit automatically",
  "deletion": "user can delete individual records, stores, or entire device-local database via explicit confirmation",
  "encryption": "not implemented; plaintext exported files must be treated as sensitive",
  "no_background_sync": true,
  "storage_availability": "browser dependent; quota/private mode restrictions must be handled and surfaced"
