{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PCI feedback v1",
  "type": "object",
  "required": [
    "id",
    "schema_version",
    "title",
    "feedback_text",
    "ordered_fields",
    "no_ai_assessment"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "feedback_text": {
      "type": "string",
      "minLength": 1
    },
    "ordered_fields": {
      "type": "array",
      "minItems": 1
    },
    "no_ai_assessment": {
      "const": true
    }
  },
  "additionalProperties": true
}
