{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PCI scenario v1",
  "type": "object",
  "required": [
    "id",
    "record_type",
    "schema_version",
    "chapter_id",
    "title",
    "source_refs",
    "linked_concept_ids",
    "nodes",
    "start_node",
    "exit_node",
    "known_facts",
    "safety"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^PCI-[A-Z0-9-]+$"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "chapter_id": {
      "type": "string",
      "pattern": "^PCI-CH-[0-9]{2}$"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1
    },
    "record_type": {
      "const": "branching_scenario"
    },
    "linked_concept_ids": {
      "type": "array",
      "minItems": 1
    },
    "nodes": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "decision",
              "outcome",
              "safe_exit"
            ]
          }
        }
      }
    },
    "start_node": {
      "type": "string",
      "minLength": 1
    },
    "exit_node": {
      "type": "string",
      "minLength": 1
    },
    "known_facts": {
      "type": "array",
      "minItems": 1
    },
    "safety": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
