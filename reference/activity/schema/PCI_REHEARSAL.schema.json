{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PCI rehearsal v1",
  "type": "object",
  "required": [
    "id",
    "record_type",
    "schema_version",
    "chapter_id",
    "title",
    "source_refs",
    "phases",
    "timing",
    "completion_rule",
    "safety",
    "linked_concept_ids"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^PCI-[A-Z0-9-]+$"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "chapter_id": {
      "type": "string",
      "pattern": "^PCI-CH-[0-9]{2}$"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1
    },
    "record_type": {
      "const": "rehearsal_template"
    },
    "phases": {
      "type": "array",
      "minItems": 5
    },
    "timing": {
      "type": "object",
      "required": [
        "full_seconds",
        "reduced_seconds",
        "no_timer_supported",
        "phase_seconds_sum"
      ]
    },
    "completion_rule": {
      "type": "object"
    },
    "safety": {
      "type": "object"
    },
    "linked_concept_ids": {
      "type": "array",
      "minItems": 1
    }
  },
  "additionalProperties": true
}
