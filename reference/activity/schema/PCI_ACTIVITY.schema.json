{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PCI activity v1",
  "type": "object",
  "required": [
    "id",
    "record_type",
    "schema_version",
    "chapter_id",
    "title",
    "adapted_from_educational_id",
    "concept_ids",
    "source_refs",
    "steps",
    "start_step_id",
    "completion_rule",
    "safety",
    "feedback_policy"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^PCI-[A-Z0-9-]+$"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "chapter_id": {
      "type": "string",
      "pattern": "^PCI-CH-[0-9]{2}$"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1
    },
    "record_type": {
      "const": "executable_activity"
    },
    "adapted_from_educational_id": {
      "type": "string",
      "minLength": 1
    },
    "concept_ids": {
      "type": "array",
      "minItems": 1
    },
    "steps": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "prompt",
          "navigation",
          "input"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "navigation": {
            "type": "object"
          },
          "input": {
            "type": "object",
            "required": [
              "field",
              "type",
              "required"
            ]
          }
        }
      }
    },
    "start_step_id": {
      "type": "string",
      "minLength": 1
    },
    "completion_rule": {
      "type": "object"
    },
    "safety": {
      "type": "object"
    },
    "feedback_policy": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
