{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PCI rubric v1",
  "type": "object",
  "required": [
    "id",
    "schema_version",
    "title",
    "dimensions",
    "max_total",
    "no_automatic_semantic_grading"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "dimensions": {
      "type": "array",
      "minItems": 1
    },
    "max_total": {
      "type": "integer"
    },
    "no_automatic_semantic_grading": {
      "const": true
    }
  },
  "additionalProperties": true
}
