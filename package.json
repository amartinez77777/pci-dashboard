{
  "name": "psycho-cybernetics-intelligence",
  "private": true,
  "version": "1.1.0-rc.1",
  "type": "module",
  "description": "PCI v1.1 enhanced local-first source candidate; real React18/Vite build not yet verified",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
